// Prisma Schema for Real-Time Community Map & Incident Reporting Web App
// Supports PostgreSQL with PostGIS extensions

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum IncidentType {
  FLOOD          // น้ำท่วม
  TRAFFIC        // รถติด
  ACCIDENT       // อุบัติเหตุ
  ROAD_CLOSED    // ถนนปิด
  TRANSIT        // รถไฟฟ้าขัดข้อง
  EMERGENCY      // เหตุการณ์ฉุกเฉิน
  GENERAL        // รายงานทั่วไป
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  ACTIVE
  MONITORING
  RESOLVED
  EXPIRED
}

enum SourceType {
  COMMUNITY
  EXTERNAL_API
  VERIFIED_AGENCY
}

enum ConfidenceLevel {
  LOW
  MEDIUM
  COMMUNITY_VERIFIED
  OFFICIAL_VERIFIED
}

enum UserRole {
  USER
  TRUSTED_REPORTER
  MODERATOR
  ADMIN
}

enum TransitLineType {
  BTS
  MRT
  ARL
  SRT
  OTHER
}

enum TransitStatus {
  NORMAL
  DELAYED
  SERVICE_DISRUPTION
  SUSPENDED
}

model User {
  id            String         @id @default(uuid())
  email         String?        @unique
  username      String         @unique
  name          String?
  avatarUrl     String?
  role          UserRole       @default(USER)
  reputation    Int            @default(10)
  isBanned      Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  incidents     Incident[]     @relation("ReportedIncidents")
  confirmations Confirmation[]
  comments      Comment[]
  savedAreas    SavedArea[]
  auditLogs     AuditLog[]

  @@map("users")
}

model Incident {
  id              String          @id @default(uuid())
  type            IncidentType
  title           String
  description     String
  latitude        Float
  longitude       Float
  locationName    String
  district        String?
  province        String          @default("กรุงเทพมหานคร")
  severity        Severity        @default(MEDIUM)
  status          IncidentStatus  @default(ACTIVE)
  source          SourceType      @default(COMMUNITY)
  confidence      ConfidenceLevel @default(MEDIUM)
  
  // Verification metrics
  confirmCount    Int             @default(0)
  disputeCount    Int             @default(0)
  
  // Specific category payload (JSON format for extra fields)
  // Flood: waterLevelCm, smallCarPassable, largeTruckPassable, roadBlocked, strongCurrent, electricRisk
  // Traffic: speedKmh, queueLengthKm, cause, direction
  // Transit: lineId, stationId, delayMinutes
  metadata        Json?

  createdById     String?
  createdBy       User?           @relation("ReportedIncidents", fields: [createdById], references: [id], onDelete: SetNull)
  
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  lastVerifiedAt  DateTime?       @default(now())
  resolvedAt      DateTime?
  expiresAt       DateTime?

  // Relations
  images          IncidentImage[]
  updates         IncidentUpdate[]
  confirmations   Confirmation[]
  comments        Comment[]

  @@index([latitude, longitude])
  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@map("incidents")
}

model IncidentImage {
  id          String    @id @default(uuid())
  incidentId  String
  incident    Incident  @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  url         String
  thumbnailUrl String?
  caption     String?
  createdAt   DateTime  @default(now())

  @@map("incident_images")
}

model IncidentUpdate {
  id          String    @id @default(uuid())
  incidentId  String
  incident    Incident  @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  action      String    // CREATED, STATUS_CHANGE, IMAGE_ADDED, VERIFIED, RESOLVED
  description String
  createdAt   DateTime  @default(now())

  @@map("incident_updates")
}

model Confirmation {
  id          String    @id @default(uuid())
  incidentId  String
  incident    Incident  @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  isStillActive Boolean // true = ยังเกิดอยู่, false = ไม่พบเหตุการณ์
  ipHash      String?
  createdAt   DateTime  @default(now())

  @@unique([incidentId, userId])
  @@map("confirmations")
}

model Comment {
  id          String    @id @default(uuid())
  incidentId  String
  incident    Incident  @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName    String    @default("ผู้ใช้งานทั่วไป")
  message     String
  createdAt   DateTime  @default(now())

  @@map("comments")
}

model TransportLine {
  id          String          @id
  name        String
  nameEn      String
  type        TransitLineType
  colorCode   String
  status      TransitStatus   @default(NORMAL)
  statusDetail String?
  updatedAt   DateTime        @updatedAt

  stations    TransportStation[]

  @@map("transport_lines")
}

model TransportStation {
  id          String        @id
  lineId      String
  line        TransportLine @relation(fields: [lineId], references: [id], onDelete: Cascade)
  code        String
  name        String
  nameEn      String
  latitude    Float
  longitude   Float
  status      TransitStatus @default(NORMAL)

  @@map("transport_stations")
}

model SavedArea {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  latitude    Float
  longitude   Float
  radiusKm    Float     @default(3.0)
  notifyEmail Boolean   @default(true)
  notifyPush  Boolean   @default(true)
  createdAt   DateTime  @default(now())

  @@map("saved_areas")
}

model AuditLog {
  id          String    @id @default(uuid())
  adminId     String?
  admin       User?     @relation(fields: [adminId], references: [id], onDelete: SetNull)
  action      String    // HIDE_INCIDENT, RESOLVE_INCIDENT, BAN_USER, MERGE_INCIDENT
  targetType  String    // INCIDENT, USER
  targetId    String
  details     String?
  createdAt   DateTime  @default(now())

  @@map("audit_logs")
}
